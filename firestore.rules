rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /mods/{modId} {
      allow read: if true;
      // Any signed-in (anonymous) visitor may write — required so ratings and
      // download counts work. Admin passcode in the app is client-side only.
      allow write: if request.auth != null;
    }
  }
}
